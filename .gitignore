# Secrets
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node / Next.js
node_modules/
.next/
*.tsbuildinfo

# Model artifacts
*.pkl
*.joblib
artifacts/

# Claude Code - settings.json is shared, settings.local.json is per-developer
.claude/settings.local.json

# Cricsheet raw downloads (huge, non-commercial licence - never redistribute
# via git) and load-run artifacts. api/data/*.json seed files (e.g.
# known_team_aliases.json) are unaffected - these are subdirectories.
api/data/cricsheet/
api/data/load_reports/
api/data/backups/
api/data/eval_reports/
api/data/models/

# Stray capture files from shell redirects with unset variables
/.txt

# setuptools build artifacts. `pip wheel ./api` writes api/build/lib/ with a
# full copy of src/ in it - a stale duplicate of every module, which is
# exactly the kind of thing that gets grepped and believed later.
api/build/
