# Public Supabase project URL - safe in the browser bundle
# Bare project URL only - no /rest/... path suffix, no trailing slash
# (a path suffix breaks Realtime and double-prefixes REST calls)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public publishable key - safe in the browser bundle, RLS protects the data (dashboard > API keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret key, bypasses RLS - route handlers only, NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_...
# Base URL of the FastAPI service on Railway, for agent tool calls (Phase 6)
API_BASE_URL=http://localhost:8000
# Shared secret authenticating this app's calls to the FastAPI tool endpoints (Phase 6)
AGENT_TOOL_SHARED_SECRET=changeme
# Anthropic API key, powers the streaming agent chat loop (Phase 6) - server-only
ANTHROPIC_API_KEY=sk-ant-...
