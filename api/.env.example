# Docker-compose training Postgres (see docker-compose.yml)
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cricket_training
# Local cache dir for downloaded/extracted Cricsheet JSON
CRICSHEET_DATA_DIR=./data/cricsheet
# Supabase project REST URL (dashboard > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
# Server-side secret key, bypasses RLS - never expose to the browser (dashboard > API keys)
SUPABASE_SECRET_KEY=sb_secret_...
# Direct Postgres connection, port 5432, for the long-running Railway worker (Phase 2)
SUPABASE_DB_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
# Read-only Postgres role for the agent's SQL tool, created in a migration (Phase 6)
AGENT_SQL_ROLE_DB_URL=postgresql://agent_ro:[password]@db.your-project.supabase.co:5432/postgres
# Shared secret authenticating web -> FastAPI tool calls (Phase 6)
AGENT_TOOL_SHARED_SECRET=changeme
# Anthropic API key, powers scouting reports and match narratives (Phase 2+)
ANTHROPIC_API_KEY=sk-ant-...
# Which LiveClient implementation to load: cricketdata | sportmonks | roanuz (Phase 2)
LIVE_API_PROVIDER=cricketdata
# API key for the chosen live provider (Phase 2)
LIVE_API_KEY=changeme
# Port the FastAPI service binds to (Railway usually injects this automatically)
PORT=8000
