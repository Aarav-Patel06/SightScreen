# Docker-compose training Postgres (see docker-compose.yml) - port must match
# the port docker-compose.yml maps postgres to (5433, not the 5432 default)
LOCAL_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cricket_training?sslmode=disable
# Local cache dir for downloaded/extracted Cricsheet JSON
CRICSHEET_DATA_DIR=./data/cricsheet
# Supabase project REST URL (dashboard > Project Settings > API)
# Bare project URL only - no /rest/... path suffix, no trailing slash
# (a path suffix breaks Realtime and double-prefixes REST calls)
SUPABASE_URL=https://your-project.supabase.co
# Server-side secret key, bypasses RLS - never expose to the browser (dashboard > API keys)
SUPABASE_SECRET_KEY=sb_secret_...
# Direct connections (db.<ref>.supabase.co) resolve over IPv6 only and are
# unreachable from Railway or Docker's default bridge network - always go
# through Supavisor instead. Copy both strings from the dashboard's Connect
# button; don't hand-assemble them, the region prefix varies. Note the
# username is "postgres.<PROJECT_REF>", not bare "postgres".
#
# Session mode (5432) - Railway live worker, Railway FastAPI, migrations,
# admin scripts. Required for anything using SET or temp tables; transaction
# mode doesn't reliably reset session state between clients.
SUPABASE_SESSION_POOLER_URL=postgresql://postgres.your-project:[password]@aws-0-your-region.pooler.supabase.com:5432/postgres
# Transaction mode (6543) - Vercel functions and anything serverless. No
# prepared statements in this mode; disable them in your client.
SUPABASE_TRANSACTION_POOLER_URL=postgresql://postgres.your-project:[password]@aws-0-your-region.pooler.supabase.com:6543/postgres
# Read-only Postgres role for the agent's SQL tool, created in a migration
# (Phase 6) - its own role and password, never a copy of the credentials
# above. Leave empty until then.
AGENT_SQL_ROLE_DB_URL=
# Shared secret authenticating web -> FastAPI tool calls (Phase 6)
AGENT_TOOL_SHARED_SECRET=changeme
# Anthropic API key, powers scouting reports and match narratives (Phase 2+)
ANTHROPIC_API_KEY=sk-ant-...
# Which LiveClient implementation to load: cricketdata | sportmonks | roanuz (Phase 2)
LIVE_API_PROVIDER=cricketdata
# API key for the chosen live provider (Phase 2)
LIVE_API_KEY=changeme
# Port the FastAPI service binds to (Railway usually injects this automatically)
PORT=8000
